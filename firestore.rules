rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'timegig2026@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidUser(data) {
      let allowedKeys = ['userId', 'email', 'firstName', 'lastName', 'phone', 'locationName', 'locationCoords', 'lastProfilePicUpdate', 'planType', 'isActivated', 'profilePicUrl', 'invitedBy', 'referralStatus', 'createdAt', 'updatedAt', 'activatedAt', 'isAdmin', 'tenantCapacity', 'userCapacity', 'tenantSubSignups', 'userSubSignups', 'socialLinks', 'isFrozen', 'lastSeenAt'];
      return data.keys().hasAll(['userId', 'email']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             (!data.keys().hasAny(['firstName']) || (data.firstName is string && data.firstName.size() <= 128)) &&
             (!data.keys().hasAny(['lastName']) || (data.lastName is string && data.lastName.size() <= 128)) &&
             (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 64)) &&
             (!data.keys().hasAny(['locationName']) || (data.locationName is string && data.locationName.size() <= 256)) &&
             (!data.keys().hasAny(['locationCoords']) || data.locationCoords == null || (data.locationCoords is map && data.locationCoords.lat is number && data.locationCoords.lon is number)) &&
             (!data.keys().hasAny(['lastProfilePicUpdate']) || data.lastProfilePicUpdate is number) &&
             (!data.keys().hasAny(['invitedBy']) || (data.invitedBy is string && data.invitedBy.size() <= 128)) &&
             (!data.keys().hasAny(['referralStatus']) || data.referralStatus in ['pending', 'approved', 'rejected']) &&
             (!data.keys().hasAny(['planType']) || data.planType in ['tenant', 'user']) &&
             (!data.keys().hasAny(['isActivated']) || data.isActivated is bool) &&
             (!data.keys().hasAny(['isAdmin']) || data.isAdmin is bool) &&
             (!data.keys().hasAny(['profilePicUrl']) || (data.profilePicUrl is string && data.profilePicUrl.size() <= 1048576)) &&
             (!data.keys().hasAny(['tenantCapacity']) || data.tenantCapacity is number) &&
             (!data.keys().hasAny(['userCapacity']) || data.userCapacity is number) &&
             (!data.keys().hasAny(['tenantSubSignups']) || data.tenantSubSignups is number) &&
             (!data.keys().hasAny(['userSubSignups']) || data.userSubSignups is number) &&
             (!data.keys().hasAny(['socialLinks']) || data.socialLinks is list) &&
             (!data.keys().hasAny(['isFrozen']) || data.isFrozen is bool) &&
             (!data.keys().hasAny(['lastSeenAt']) || data.lastSeenAt is timestamp || data.lastSeenAt == null);
    }

    function isValidSetting(data) {
      let allowedKeys = ['userId', 'isSoundEnabled', 'isHudMinimized', 'deletedNotifications', 'updatedAt'];
      return data.keys().hasAll(['userId']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.userId == request.auth.uid &&
             (!data.keys().hasAny(['isSoundEnabled']) || data.isSoundEnabled is bool) &&
             (!data.keys().hasAny(['isHudMinimized']) || data.isHudMinimized is bool) &&
             (!data.keys().hasAny(['deletedNotifications']) || (data.deletedNotifications is list && data.deletedNotifications.size() <= 500));
    }

    function isValidGig(data) {
      let allowedKeys = ['ownerId', 'seekerId', 'status', 'destination', 'createdAt', 'updatedAt', 'cancelReason', 'cancelledBy'];
      return data.keys().hasAll(['ownerId', 'seekerId', 'status', 'destination']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.seekerId is string && data.seekerId.size() <= 128 &&
             data.status in ['pending', 'accepted', 'completed', 'cancelled'] &&
             data.destination is map &&
             data.destination.keys().hasAll(['lat', 'lon', 'name']) &&
             data.destination.keys().hasOnly(['lat', 'lon', 'name']) &&
             data.destination.lat is number &&
             data.destination.lon is number &&
             data.destination.name is string && data.destination.name.size() <= 256;
    }

    function isValidChatRoom(data) {
      let allowedKeys = ['participants', 'lastMessage', 'lastMessageAt'];
      return data.keys().hasAll(['participants']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.participants is list && data.participants.size() == 2 &&
             data.participants[0] is string && data.participants[1] is string;
    }

    function isValidChatMessage(data) {
      let allowedKeys = ['text', 'senderId', 'senderEmail', 'createdAt'];
      return data.keys().hasAll(['text', 'senderId', 'senderEmail']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.text is string && data.text.size() <= 1000 &&
             data.senderId == request.auth.uid &&
             data.senderEmail is string;
    }

    // 4. Collection Matches
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().userId == request.auth.uid && 
                    (!incoming().keys().hasAny(['isAdmin']) || isAdmin());
      
      allow update: if (isOwner(userId) || isAdmin() || (isSignedIn() && existing().invitedBy == request.auth.uid)) && isValidUser(incoming()) && (
        // Action: Profile Update (Owner only, restricted fields, cannot change isAdmin)
        (isOwner(userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'phone', 'locationName', 'locationCoords', 'profilePicUrl', 'lastProfilePicUpdate', 'planType', 'isActivated', 'activatedAt', 'updatedAt', 'lastSeenAt']) && 
         (!incoming().keys().hasAny(['isAdmin']) || incoming().isAdmin == existing().isAdmin)) ||
        // Action: Tenant approve/reject referral or freeze/unfreeze account
        ((isSignedIn() && (existing().invitedBy == request.auth.uid || request.auth.token.email == 'timegig2026@gmail.com')) && incoming().diff(existing()).affectedKeys().hasOnly(['referralStatus', 'isFrozen', 'updatedAt'])) ||
        // Action: Admin Full Access
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    match /settings/{userId} {
      allow get: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSetting(incoming());
    }

    match /gigs/{gigId} {
      function isGigParticipant() {
        return isSignedIn() && (existing().ownerId == request.auth.uid || existing().seekerId == request.auth.uid);
      }

      allow get: if isGigParticipant() || isAdmin();
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.seekerId == request.auth.uid);

      allow create: if isSignedIn() && isValidGig(incoming()) && incoming().ownerId == request.auth.uid;

      allow update: if (isGigParticipant() || isAdmin()) && isValidGig(incoming()) && (
        // Terminal state check
        existing().status in ['completed', 'cancelled'] == false || isAdmin()
      ) && (
        // Action: Accept (Seeker only)
        (existing().seekerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'accepted') ||
        // Action: Complete (Owner only)
        (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'completed') ||
        // Action: Cancel
        (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledBy', 'updatedAt'])) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      function isChatParticipant() {
        return isSignedIn() && request.auth.uid in existing().participants;
      }

      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && isValidChatRoom(incoming()) && request.auth.uid in incoming().participants;
      allow update: if isChatParticipant() && isValidChatRoom(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt']);

      match /messages/{messageId} {
        allow read, list: if isChatParticipant();
        allow create: if isChatParticipant() && isValidChatMessage(incoming());
      }
    }
  }
}
