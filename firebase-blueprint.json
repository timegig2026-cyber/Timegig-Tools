{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and activation status",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "locationName": { "type": "string" },
        "locationCoords": { "type": "object" },
        "lastProfilePicUpdate": { "type": "number" },
        "planType": { "type": "string", "enum": ["tenant", "user"] },
        "isActivated": { "type": "boolean" },
        "profilePicUrl": { "type": "string" },
        "invitedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Setting": {
      "title": "Setting",
      "description": "User specific app settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "isSoundEnabled": { "type": "boolean" },
        "isHudMinimized": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "Gig": {
      "title": "Gig",
      "description": "A gig service agreement between a user and a seeker",
      "type": "object",
      "properties": {
        "gigId": { "type": "string" },
        "ownerId": { "type": "string" },
        "seekerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "cancelled"] },
        "cancelReason": { "type": "string" },
        "cancelledBy": { "type": "string" },
        "destination": { "type": "object", "properties": { "lat": { "type": "number" }, "lon": { "type": "number" }, "name": { "type": "string" } } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gigId", "ownerId", "seekerId", "status"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "A direct message room between two users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message within a chat room",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId", "senderEmail"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/settings/{userId}": {
      "schema": "Setting",
      "description": "User settings"
    },
    "/gigs/{gigId}": {
      "schema": "Gig",
      "description": "Gig transaction records"
    },
    "/chatRooms/{roomId}": {
      "schema": "ChatRoom",
      "description": "Direct message rooms"
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages in a room"
    }
  }
}
