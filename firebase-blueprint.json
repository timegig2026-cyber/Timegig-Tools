{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and activation status",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "planType": { "type": "string", "enum": ["tenant", "user"] },
        "isActivated": { "type": "boolean" },
        "profilePicUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Setting": {
      "title": "Setting",
      "description": "User specific app settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "isSoundEnabled": { "type": "boolean" },
        "isHudMinimized": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/settings/{userId}": {
      "schema": "Setting",
      "description": "User settings"
    }
  }
}
